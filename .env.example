# ============================================================
# GestFichier - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Obligatoire ---
# Clé secrète Django (générez une longue chaîne aléatoire)
SECRET_KEY=changez-moi-par-une-cle-tres-longue-et-aleatoire

# Mode debug (True en local, False en production)
DEBUG=False

# Domaines autorisés (séparés par des virgules)
# Exemple Render: .onrender.com
# Exemple local: localhost,127.0.0.1
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# --- Base de données PostgreSQL (Neon / autre) ---
# Si vous avez une URL Neon du type:
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# alors remplissez ainsi:

DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=votre_mot_de_passe_ici
DB_HOST=ep-xxxxx.eu-central-1.aws.neon.tech
DB_PORT=5432

# --- Optionnel ---
# Pour tester en local SANS PostgreSQL (utilise SQLite à la place)
# USE_SQLITE=1

# --- Cloudflare R2 (stockage fichiers persistant) ---
# USE_S3=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=geastfichier
# AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
